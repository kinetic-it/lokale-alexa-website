{{- $lang := .Language.Lang -}}
{{- $s := hugo.Data.status -}}
{{- $self := "feed.xml" | absLangURL -}}
{{- $stand := (site.GetPage "/stand").Permalink -}}
{{- $befunde := (site.GetPage "/befunde").Permalink -}}
{{- $texts := slice -}}
{{- if eq $lang "en" }}{{ $texts = $s.en.history }}{{ else }}{{ range $s.history }}{{ $texts = $texts | append .text }}{{ end }}{{ end -}}
{{- /* Verlauf und Befunde in einem Feed. Sortierschlüssel: Datum, dann Verlauf vor Befund, dann Reihenfolge in der Quelle. */ -}}
{{- $sc := newScratch -}}
{{- $entries := slice -}}
{{- range $i, $h := $s.history -}}
{{- $n := add ($sc.Get $h.date | default 0) 1 -}}{{- $sc.Set $h.date $n -}}
{{- $t := index $texts $i -}}
{{- $title := $t -}}{{- if gt (strings.RuneCount $t) 90 }}{{ $title = printf "%s..." (strings.TrimRight " " (substr $t 0 87)) }}{{ end -}}
{{- $entries = $entries | append (dict "k" (printf "%s-1-%03d" $h.date $i) "d" $h.date "title" $title "sum" $t "id" (printf "%s-%d" $h.date $n) "url" (printf "%s#v-%s-%d" $stand $h.date $n)) -}}
{{- end -}}
{{- $fn := len hugo.Data.findings.entries -}}
{{- range $i, $f := hugo.Data.findings.entries -}}
{{- $t := index $f $lang -}}
{{- $entries = $entries | append (dict "k" (printf "%s-2-%03d" $f.date (sub $fn $i)) "d" $f.date "title" $t.title "sum" $t.text "id" (printf "befund-%s" $f.id) "url" (printf "%s#%s" $befunde $f.id)) -}}
{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ $lang }}">
  <title>{{ .Site.Params.feedtitle }}</title>
  <subtitle>{{ .Site.Params.feedsub }}</subtitle>
  <id>{{ $self }}</id>
  <link rel="self" type="application/atom+xml" href="{{ $self }}"/>
  <link rel="alternate" type="text/html" href="{{ .Permalink }}"/>
  <updated>{{ (index (sort $entries "k" "desc") 0).d }}T00:00:00Z</updated>
  <author><name>kinetic-it</name></author>
{{- range sort $entries "k" "desc" }}
  <entry>
    <title>{{ .title }}</title>
    <id>tag:kinetic-it.github.io,2026:lokale-alexa/{{ $lang }}/{{ .id }}</id>
    <link rel="alternate" type="text/html" href="{{ .url }}"/>
    <updated>{{ .d }}T00:00:00Z</updated>
    <summary>{{ .sum }}</summary>
  </entry>
{{- end }}
</feed>
